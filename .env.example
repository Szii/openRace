# Copy this file to ".env" and fill in what you have. Both are OPTIONAL.
# The game runs with neither (it falls back to raw OpenStreetMap street tiles).

# Free Cesium ion token -> world terrain + Cesium OSM 3D Buildings.
# Get one free (no billing) at https://ion.cesium.com  -> Access Tokens.
VITE_CESIUM_ION_TOKEN=

# Google "Map Tiles API" key -> Google Photorealistic 3D Tiles (paid, needs billing).
# https://developers.google.com/maps/documentation/tile/3d-tiles
VITE_GOOGLE_MAPS_API_KEY=
